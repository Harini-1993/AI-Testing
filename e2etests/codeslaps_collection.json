{
  "info": {
    "name": "CodeSlaps API Tests",
    "_postman_id": "e2e-codeslaps-001",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "GET Homepage",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "https://www.codeslaps.com", "protocol": "https", "host": ["www","codeslaps","com"] }
      },
      "event": [{
        "listen": "test",
        "script": {
          "exec": [
            "pm.test('Status is 200', () => pm.response.to.have.status(200));",
            "pm.test('Response time < 3s', () => pm.expect(pm.response.responseTime).to.be.below(3000));"
          ]
        }
      }]
    },
    {
      "name": "GET /blog (if exists)",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "https://www.codeslaps.com/blog", "protocol": "https", "host": ["www","codeslaps","com"], "path": ["blog"] }
      },
      "event": [{
        "listen": "test",
        "script": {
          "exec": ["pm.test('Page reachable', () => pm.response.to.have.status(200));"]
        }
      }]
    }
  ]
}